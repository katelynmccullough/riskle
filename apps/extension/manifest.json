{
  "manifest_version": 3,
  "name": "Riskle Local Companion",
  "version": "0.2.0",
  "description": "Companion for the local Riskle mock puzzle. No Wordle detection.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Riskle local demo",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
